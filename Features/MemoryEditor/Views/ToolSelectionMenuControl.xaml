<UserControl x:Class="InazumaElevenVRSaveEditor.Features.MemoryEditor.Views.ToolSelectionMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Cheat Menu"
                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Select a tool to use. Make sure the game is closed before using these tools."
                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                         Opacity="0.7"
                         TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <!-- Quick Toggles Section -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                       CornerRadius="8"
                       Margin="0,10,0,0">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Resources/Cards/Stars.png"
                               Width="32"
                               Height="32"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Current Status"
                                     FontSize="12"
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding MemoryEditor.StatusMessage}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Margin="0,5,0,0"/>
                            <TextBlock Text="Click attach to connect to the game"
                                     FontSize="11"
                                     Opacity="0.6"
                                     Margin="0,5,0,0"
                                     FontStyle="Italic"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                              Command="{Binding MemoryEditor.AttachToProcessCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="45"
                              VerticalAlignment="Center"
                              Background="#4CAF50">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Link"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Attach to Game"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                              Command="{Binding MemoryEditor.DetachFromProcessCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="45"
                              VerticalAlignment="Center"
                              Background="#D32F2F"
                              Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkOff"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Detach"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Freeze Items Toggle (Stars) -->
                <Border Background="#4CAF50"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                               Kind="Snowflake"
                                               Width="28"
                                               Height="28"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"
                                               Foreground="White"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Freeze Items"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Prevent items from decreasing (unlimited items)"
                                     FontSize="11"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                     IsChecked="{Binding MemoryEditor.IsStarsFrozen, Mode=OneWay}"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     ToolTip="Toggle freeze on/off"
                                     Command="{Binding MemoryEditor.ToggleStarsFreezeCommand}"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"/>

                        <Button Grid.Column="3"
                               Command="{Binding MemoryEditor.OpenItemListCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#2196F3"
                               Height="35"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted"
                                                       Width="18"
                                                       Height="18"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="Working on Items"
                                         VerticalAlignment="Center"
                                         FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Increment Items Toggle (Flowers) -->
                <Border Background="#FF9800"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                               Kind="TrendingUp"
                                               Width="28"
                                               Height="28"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"
                                               Foreground="White"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Increment Items on Use"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Items increase instead of decrease when buying"
                                     FontSize="11"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                     IsChecked="{Binding MemoryEditor.IsFlowersIncrementEnabled, Mode=OneWay}"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     ToolTip="Toggle increment on/off"
                                     Command="{Binding MemoryEditor.ToggleFlowersIncrementCommand}"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"/>

                        <Button Grid.Column="3"
                               Command="{Binding MemoryEditor.OpenItemListCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#2196F3"
                               Height="35"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted"
                                                       Width="18"
                                                       Height="18"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="Working on Items"
                                         VerticalAlignment="Center"
                                         FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Freeze Spirits Toggle -->
                <Border Background="#9C27B0"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                               Kind="Snowflake"
                                               Width="28"
                                               Height="28"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"
                                               Foreground="White"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Freeze Spirits"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Prevent spirits from decreasing (unlimited spirits)"
                                     FontSize="11"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                     IsChecked="{Binding MemoryEditor.IsSpiritsFrozen, Mode=OneWay}"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     ToolTip="Toggle freeze on/off"
                                     Command="{Binding MemoryEditor.ToggleSpiritsFreezeCommand}"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Store Item Multiplier Toggle -->
                <Border Background="#F44336"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                               Kind="Multiplication"
                                               Width="28"
                                               Height="28"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"
                                               Foreground="White"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Store Item Multiplier"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Multiply items (including hissatsus) received from store purchases"
                                     FontSize="11"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Multiplier:"
                                         FontSize="11"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBox Width="80"
                                         Height="32"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding MemoryEditor.StoreItemMultiplier, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                     IsChecked="{Binding MemoryEditor.IsStoreItemMultiplierEnabled, Mode=OneWay}"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     ToolTip="Toggle multiplier on/off"
                                     Command="{Binding MemoryEditor.ToggleStoreItemMultiplierCommand}"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Inventory Hissatsu Amount Setter -->
                <Border Background="#3F51B5"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                               Kind="PlaylistEdit"
                                               Width="28"
                                               Height="28"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"
                                               Foreground="White"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Inventory Hissatsu Amount"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Text="Directly edit the stack count for a hissatsu in your inventory"
                                     FontSize="11"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Address (hex or dec):"
                                         FontSize="11"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBox Width="140"
                                         Height="32"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding MemoryEditor.InventoryHissatsuAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Desired amount:"
                                         FontSize="11"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBox Width="80"
                                         Height="32"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding MemoryEditor.InventoryHissatsuAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding MemoryEditor.ApplyInventoryHissatsuAmountCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="45"
                                VerticalAlignment="Center"
                                Background="#283593"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveEdit"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Apply"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Hissatsu Inventory Browser -->
                <Border Background="#1E88E5"
                       CornerRadius="8"
                       Margin="0,10,0,0"
                       Visibility="{Binding MemoryEditor.IsAttached, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FormatListNumbered"
                                                       Width="28"
                                                       Height="28"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       Foreground="White"/>
                                <StackPanel>
                                    <TextBlock Text="Hissatsu Inventory Browser"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Foreground="White"/>
                                    <TextBlock Text="Reads your current inventory slots and lets you edit the amounts"
                                             FontSize="11"
                                             Foreground="White"
                                             Opacity="0.9"
                                             Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding MemoryEditor.RefreshHissatsuInventoryCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="36"
                                    VerticalAlignment="Center"
                                    Background="#1565C0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                           Width="18"
                                                           Height="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh"
                                             VerticalAlignment="Center"
                                             FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1"
                                  Margin="0,10,0,10"
                                  ItemsSource="{Binding MemoryEditor.HissatsuInventoryEntries}"
                                  SelectedItem="{Binding MemoryEditor.SelectedHissatsuInventoryEntry, Mode=TwoWay}"
                                  Height="230"
                                  BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180" />
                                    <GridViewColumn Header="Amount" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Width="70"
                                                         Padding="4,2"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding AddressDisplay}" Width="120" />
                                    <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="220" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Only slots with an amount greater than zero are shown. Names are matched from the catalog when possible."
                                       FontSize="11"
                                       Foreground="White"
                                       Opacity="0.85"
                                       TextWrapping="Wrap"
                                       Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Command="{Binding MemoryEditor.ApplySelectedInventoryHissatsuCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="#0D47A1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveEdit"
                                                           Width="18"
                                                           Height="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Save Selected"
                                             VerticalAlignment="Center"
                                             FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </materialDesign:Card>

        <!-- Tool Selection Cards - IsEnabled="{Binding MemoryEditor.IsNotUnderMaintenance}" --> 
        <materialDesign:Card Grid.Row="1" Style="{StaticResource CardStyle}" Margin="-10,-10,0,0" VerticalAlignment="Top" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Star Editor Card -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                   Margin="0"
                                   Padding="16,12,16,12"
                                   Width="180"
                                   MinHeight="170"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="TicketEditorCard_Click"
                                   IsEnabled="{Binding MemoryEditor.IsStarsEnabled}">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/Cards/Stars.png"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Stars"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,4"/>

                        <TextBlock Text="Edit gachapon stars"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,0,8,8"/>

                        <Button Command="{Binding MemoryEditor.SelectTicketEditorCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="28"
                              Padding="12,0"
                              Margin="0,0,0,0"
                              Background="{DynamicResource SecondaryHueMidBrush}"
                              Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRight"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Open"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Maintenance Overlay -->
                    <Border Background="#CC808080"
                           CornerRadius="4"
                           Visibility="{Binding MemoryEditor.IsStarsUnderMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"
                           IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lock"
                                                   Width="48"
                                                   Height="48"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"/>
                            <TextBlock Text="UNDER"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                            <TextBlock Text="MAINTENANCE"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Ina Flowers Editor Card -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                   Margin="10,0,0,0"
                                   Padding="16,12,16,12"
                                   Width="180"
                                   MinHeight="170"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="InaFlowersEditorCard_Click"
                                   IsEnabled="{Binding MemoryEditor.IsFlowersEnabled}">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/Cards/Inazuma Flower.png"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Kizuna Flowers"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,4"/>

                        <TextBlock Text="Edit Kizuna Flowers"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,0,8,8"/>

                        <Button Command="{Binding MemoryEditor.SelectInaFlowersEditorCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="28"
                              Padding="12,0"
                              Margin="0,0,0,0"
                              Background="{DynamicResource SecondaryHueMidBrush}"
                              Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRight"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Open"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Maintenance Overlay -->
                    <Border Background="#CC808080"
                           CornerRadius="4"
                           Visibility="{Binding MemoryEditor.IsFlowersUnderMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"
                           IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lock"
                                                   Width="48"
                                                   Height="48"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"/>
                            <TextBlock Text="UNDER"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                            <TextBlock Text="MAINTENANCE"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Spirits Editor Card -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                   Margin="10,0,0,0"
                                   Padding="16,12,16,12"
                                   Width="180"
                                   MinHeight="170"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="SpiritsEditorCard_Click"
                                   IsEnabled="{Binding MemoryEditor.IsSpiritsEnabled}">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/Cards/Spirits.png"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Spirits"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,4"/>

                        <TextBlock Text="Edit Spirits"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,0,8,8"/>

                        <Button Command="{Binding MemoryEditor.SelectSpiritsEditorCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="28"
                              Padding="12,0"
                              Margin="0,0,0,0"
                              Background="{DynamicResource SecondaryHueMidBrush}"
                              Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRight"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Open"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Maintenance Overlay -->
                    <Border Background="#CC808080"
                           CornerRadius="4"
                           Visibility="{Binding MemoryEditor.IsSpiritsUnderMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"
                           IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lock"
                                                   Width="48"
                                                   Height="48"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"/>
                            <TextBlock Text="UNDER"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                            <TextBlock Text="MAINTENANCE"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Beans Editor Card -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                   Margin="10,0,0,0"
                                   Padding="16,12,16,12"
                                   Width="180"
                                   MinHeight="170"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="BeansEditorCard_Click"
                                   IsEnabled="{Binding MemoryEditor.IsBeansEnabled}">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/Cards/Kicking Power.png"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Beans"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,4"/>

                        <TextBlock Text="Edit Beans"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,0,8,8"/>

                        <Button Command="{Binding MemoryEditor.SelectBeansEditorCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="28"
                              Padding="12,0"
                              Margin="0,0,0,0"
                              Background="{DynamicResource SecondaryHueMidBrush}"
                              Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRight"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Open"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Maintenance Overlay -->
                    <Border Background="#CC808080"
                           CornerRadius="4"
                           Visibility="{Binding MemoryEditor.IsBeansUnderMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"
                           IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lock"
                                                   Width="48"
                                                   Height="48"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"/>
                            <TextBlock Text="UNDER"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                            <TextBlock Text="MAINTENANCE"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Victory Items Editor Card -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                   Margin="10,0,0,0"
                                   Padding="16,12,16,12"
                                   Width="180"
                                   MinHeight="170"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="VictoryItemsEditorCard_Click"
                                   IsEnabled="{Binding MemoryEditor.IsVictoryItemsEnabled}">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/Cards/VSTAR.png"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Victory Items"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,4"/>

                        <TextBlock Text="Edit Victory Items"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,0,8,8"/>

                        <Button Command="{Binding MemoryEditor.SelectVictoryItemsEditorCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Height="28"
                              Padding="12,0"
                              Margin="0,0,0,0"
                              Background="{DynamicResource SecondaryHueMidBrush}"
                              Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRight"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Open"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Maintenance Overlay -->
                    <Border Background="#CC808080"
                           CornerRadius="4"
                           Visibility="{Binding MemoryEditor.IsVictoryItemsUnderMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}"
                           IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lock"
                                                   Width="48"
                                                   Height="48"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"/>
                            <TextBlock Text="UNDER"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,8,0,0"/>
                            <TextBlock Text="MAINTENANCE"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
